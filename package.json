{
  "name": "nlauncher",
  "productName": "NLauncher",
  "version": "0.2.1",
  "description": "NLauncher от NeoDev — минималистичный Minecraft-лаунчер: лицензия и офлайн, сборки, моды, сервера.",
  "main": "src/main.js",
  "author": "NeoDev",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "test:e2e": "node test/e2e.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "minecraft-launcher-core": "^3.18.2",
    "minecraft-server-util": "^5.4.4",
    "msmc": "^5.0.5",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.neodev.nlauncher",
    "productName": "NLauncher",
    "files": [
      "src/**/*",
      "config.json",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NLauncher-Setup-${version}.exe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NLauncher",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049"
    },
    "icon": "build/icon.png",
    "portable": {
      "artifactName": "NLauncher-Portable-${version}.exe"
    },
    "publish": null
  }
}