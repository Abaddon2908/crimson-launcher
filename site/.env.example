# Домен сайта (A-запись должна указывать на IP вашего VPS)
DOMAIN=monitoring.example.ru
SITE_URL=https://monitoring.example.ru

# Первый администратор (создаётся при запуске; пароль потом можно убрать из файла)
ADMIN_EMAIL=you@example.ru
ADMIN_PASSWORD=смените-этот-пароль

# Как часто пинговать сервера, минут
PING_INTERVAL_MIN=5

# Куда ведёт кнопка «Скачать NLauncher»
LAUNCHER_DOWNLOAD_URL=https://github.com/Abaddon2908/crimson-launcher/releases/latest

# Ключи ЮMoney и Heleket вводятся в админке → Настройки (хранятся в базе)
